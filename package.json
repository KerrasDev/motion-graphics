{
  "name": "motion-graphics",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "dev": "pnpm --filter @motion-graphics/gallery dev --host 0.0.0.0",
    "dev:api": "pnpm --filter @motion-graphics/api dev",
    "build": "pnpm --filter @motion-graphics/gallery build",
    "build:api": "pnpm --filter @motion-graphics/api build",
    "typecheck": "tsc --noEmit -p tsconfig.base.json",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "validate:effects": "tsx scripts/validate-effects.ts",
    "registry:build": "tsx scripts/build-registry.ts",
    "check": "pnpm validate:effects && pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@motion-graphics/core": "workspace:*",
    "@motion-graphics/effects": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-react": "4.3.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "remotion": "4.0.333",
    "tsx": "^4.23.15",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vitest": "^1.6.0",
    "zod": "^4.6.5"
  }
}
