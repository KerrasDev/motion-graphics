# GitHub App user authorization, API only. Keep real values out of Git.
GITHUB_WORKSPACE_ENABLED=false
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_CALLBACK_URL=
GITHUB_GALLERY_ORIGIN=
GITHUB_SESSION_REDIS_URL=
GITHUB_SESSION_ENCRYPTION_KEY=

# Non-secret gallery build configuration.
VITE_API_BASE_URL=

# Optional Vite development proxy target.
API_PROXY_TARGET=http://127.0.0.1:4000
